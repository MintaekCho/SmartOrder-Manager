// Prisma Schema for Coupang Automation System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// NextAuth.js 인증 관련
// ============================================

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  telegramChatId String?

  // 설정 (JSON)
  settings       Json      @default("{}")

  // NextAuth 관계
  accounts       Account[]
  sessions       Session[]

  // 구독 관계
  subscription   Subscription?

  // 비즈니스 관계
  products       Product[]
  orders         Order[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// 구독 및 결제 관련
// ============================================

model Subscription {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 구독 플랜
  plan             SubscriptionPlan @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)

  // 토스페이먼츠 빌링키 (정기결제용)
  billingKey       String?
  customerKey      String?          @unique

  // 구독 기간
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // 취소 정보
  cancelAtPeriodEnd  Boolean       @default(false)
  canceledAt         DateTime?

  // 결제 내역
  payments           Payment[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("subscriptions")
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
}

model Payment {
  id               String        @id @default(cuid())
  subscriptionId   String
  subscription     Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // 토스페이먼츠 결제 정보
  paymentKey       String?       @unique
  orderId          String        @unique
  amount           Int

  // 결제 상태
  status           PaymentStatus @default(PENDING)

  // 결제 방법
  method           String?       // CARD, TRANSFER, etc.
  cardCompany      String?
  cardNumber       String?       // 마스킹된 카드번호

  // 실패 정보
  failReason       String?

  paidAt           DateTime?
  createdAt        DateTime      @default(now())

  @@index([subscriptionId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

// ============================================
// 도매처 관련
// ============================================

model Supplier {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  baseUrl     String

  // 인증 정보 (암호화 저장)
  credentials Json?

  isActive    Boolean   @default(true)

  // 관계
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("suppliers")
}

// ============================================
// 카테고리
// ============================================

model Category {
  id           String     @id @default(cuid())
  name         String
  coupangId    String?

  // 계층 구조
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")

  // 관계
  products     Product[]

  @@map("categories")
}

// ============================================
// 상품
// ============================================

model Product {
  id                   String    @id @default(cuid())

  // 관계 ID
  userId               String
  user                 User      @relation(fields: [userId], references: [id])

  supplierId           String
  supplier             Supplier  @relation(fields: [supplierId], references: [id])

  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id])

  // 도매처 정보
  supplierProductId    String
  supplierProductUrl   String?

  // 쿠팡 정보
  coupangProductId     String?
  coupangVendorItemId  String?
  coupangProductUrl    String?

  // 상품 정보
  name                 String
  description          String?   @db.Text

  // 이미지 (URL 배열)
  images               Json      @default("[]")

  // 옵션 (색상, 사이즈 등)
  options              Json      @default("[]")

  // 가격
  supplierPrice        Int
  sellingPrice         Int
  shippingFee          Int       @default(0)

  // 계산된 값
  margin               Float
  estimatedProfit      Int

  // 상태
  status               ProductStatus @default(DRAFT)

  // 메타데이터
  lastSyncedAt         DateTime?

  // 관계
  priceHistory         PriceHistory[]
  orders               Order[]
  stats                ProductStats[]

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([supplierId, supplierProductId])
  @@index([userId])
  @@index([status])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  PENDING
  REGISTERED
  ACTIVE
  PAUSED
  OUT_OF_STOCK
  DISCONTINUED
}

// ============================================
// 가격 히스토리
// ============================================

model PriceHistory {
  id              String   @id @default(cuid())

  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierPrice   Int
  sellingPrice    Int
  competitorPrice Int?

  recordedAt      DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("price_history")
}

// ============================================
// 주문
// ============================================

model Order {
  id               String      @id @default(cuid())

  // 관계
  productId        String
  product          Product     @relation(fields: [productId], references: [id])

  userId           String
  user             User        @relation(fields: [userId], references: [id])

  // 쿠팡 주문 정보
  coupangOrderId   String      @unique
  coupangOrderItemId String?

  // 주문 내용
  quantity         Int
  unitPrice        Int
  totalAmount      Int

  // 구매자 정보
  buyerName        String
  buyerPhone       String
  shippingAddress  String
  shippingMemo     String?

  // 상태
  status           OrderStatus @default(NEW)

  // 도매처 발주 정보
  supplierOrderId  String?
  supplierOrderedAt DateTime?

  // 배송 정보
  trackingCompany  String?
  trackingNumber   String?

  // 타임스탬프
  orderedAt        DateTime
  shippedAt        DateTime?
  deliveredAt      DateTime?

  // 관계
  history          OrderHistory[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, orderedAt])
  @@index([status])
  @@map("orders")
}

enum OrderStatus {
  NEW
  PENDING_ORDER
  ORDERED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

// ============================================
// 주문 히스토리
// ============================================

model OrderHistory {
  id        String      @id @default(cuid())

  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    OrderStatus
  note      String?

  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_history")
}

// ============================================
// 상품 통계
// ============================================

model ProductStats {
  id        String   @id @default(cuid())

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date

  views     Int      @default(0)
  clicks    Int      @default(0)
  sales     Int      @default(0)
  revenue   Int      @default(0)
  profit    Int      @default(0)

  @@unique([productId, date])
  @@index([date])
  @@map("product_stats")
}

// ============================================
// 시스템 설정
// ============================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ============================================
// 작업 로그
// ============================================

model JobLog {
  id        String   @id @default(cuid())

  jobType   String
  status    JobStatus

  startedAt DateTime
  endedAt   DateTime?

  result    Json?
  error     String?

  @@index([jobType, startedAt])
  @@map("job_logs")
}

enum JobStatus {
  RUNNING
  COMPLETED
  FAILED
}

// ============================================
// 리서치 - 키워드 분석
// ============================================

model Keyword {
  id              String   @id @default(cuid())

  keyword         String   @unique

  // 네이버 검색량 데이터
  naverSearchVolume    Int?      // 월간 검색량
  naverSearchTrend     Json?     // 최근 30일 트렌드 데이터

  // 쿠팡 데이터
  coupangProductCount  Int?      // 검색 결과 상품 수
  coupangAvgPrice      Int?      // 평균 가격
  coupangMinPrice      Int?      // 최저 가격
  coupangMaxPrice      Int?      // 최고 가격

  // 경쟁 강도 (계산된 지표)
  competitionScore     Float?    // 0~100 경쟁 강도
  opportunityScore     Float?    // 0~100 기회 점수

  // 관계
  snapshots       KeywordSnapshot[]
  trackedProducts TrackedProduct[]

  lastAnalyzedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([opportunityScore])
  @@map("keywords")
}

// 키워드 히스토리 (시계열 데이터)
model KeywordSnapshot {
  id              String   @id @default(cuid())

  keywordId       String
  keyword         Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  naverSearchVolume    Int?
  coupangProductCount  Int?
  coupangAvgPrice      Int?

  recordedAt      DateTime @default(now())

  @@index([keywordId, recordedAt])
  @@map("keyword_snapshots")
}

// ============================================
// 리서치 - 쿠팡 상품 추적
// ============================================

model TrackedProduct {
  id                  String   @id @default(cuid())

  // 쿠팡 상품 정보
  coupangProductId    String   @unique
  coupangUrl          String

  name                String
  brandName           String?
  sellerName          String?

  // 현재 상태
  currentPrice        Int
  originalPrice       Int?
  discountRate        Int?

  currentReviewCount  Int      @default(0)
  currentRating       Float?

  // 배송 정보
  isRocketDelivery    Boolean  @default(false)
  isFreeShipping      Boolean  @default(false)

  // 검색 순위 (키워드별)
  keywordId           String?
  keyword             Keyword? @relation(fields: [keywordId], references: [id])
  searchRank          Int?     // 해당 키워드 검색 시 순위

  // 관계
  priceSnapshots      ProductPriceSnapshot[]
  reviewSnapshots     ProductReviewSnapshot[]

  // 도매 매칭 정보
  matchedWholesaleUrl String?
  wholesalePrice      Int?
  estimatedMargin     Float?   // 예상 마진율

  isTracking          Boolean  @default(true)

  lastCrawledAt       DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([keywordId, searchRank])
  @@index([estimatedMargin])
  @@map("tracked_products")
}

// 상품 가격 스냅샷
model ProductPriceSnapshot {
  id              String   @id @default(cuid())

  productId       String
  product         TrackedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  price           Int
  originalPrice   Int?

  recordedAt      DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("product_price_snapshots")
}

// 리뷰 스냅샷 (리뷰 증가 속도 추적)
model ProductReviewSnapshot {
  id              String   @id @default(cuid())

  productId       String
  product         TrackedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  reviewCount     Int
  rating          Float?

  // 계산된 지표
  reviewGrowthRate Float?   // 일일 리뷰 증가율

  recordedAt      DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("product_review_snapshots")
}

// ============================================
// 리서치 - 마진 분석
// ============================================

model MarginAnalysis {
  id                  String   @id @default(cuid())

  // 검색 조건
  keyword             String

  // 쿠팡 상품 정보
  coupangProductId    String
  coupangProductName  String
  coupangPrice        Int
  coupangUrl          String

  // 도매 상품 정보
  wholesaleSource     String   // domeggook, etc.
  wholesaleProductId  String?
  wholesaleProductName String
  wholesalePrice      Int
  wholesaleUrl        String

  // 마진 계산
  priceDifference     Int      // 판매가 - 도매가
  marginRate          Float    // 마진율 (%)
  estimatedProfit     Int      // 예상 수익 (수수료 제외 후)

  // 유사도 점수
  similarityScore     Float?   // 상품 유사도 (0~1)

  analyzedAt          DateTime @default(now())

  @@index([keyword, marginRate])
  @@index([analyzedAt])
  @@map("margin_analyses")
}

// ============================================
// 리서치 - 네이버 검색 트렌드
// ============================================

model NaverTrend {
  id              String   @id @default(cuid())

  keyword         String

  // 기간
  startDate       DateTime
  endDate         DateTime

  // 트렌드 데이터 (일별)
  trendData       Json     // [{date: "2024-01-01", ratio: 85}, ...]

  // 요약 지표
  avgRatio        Float?   // 평균 비율
  maxRatio        Float?   // 최대 비율
  minRatio        Float?   // 최소 비율
  trendDirection  String?  // "rising", "falling", "stable"

  createdAt       DateTime @default(now())

  @@unique([keyword, startDate, endDate])
  @@index([keyword])
  @@map("naver_trends")
}
