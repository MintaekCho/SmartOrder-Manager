// Prisma Schema for Coupang Automation System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// NextAuth.js 인증 관련
// ============================================

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  telegramChatId String?

  // 사용자 역할 (관리자/직원/고객)
  role           UserRole   @default(CUSTOMER)

  // 시스템 모드 설정
  systemMode     SystemMode @default(DROPSHIPPING)

  // 설정 (JSON) - 기능별 활성화 등
  settings       Json      @default("{}")

  // 자사몰 고객용 필드
  providerId     String?   @unique  // OAuth provider_providerAccountId 조합
  password       String?             // 일반 로그인용 (미사용)
  phone          String?
  point          Int       @default(0)
  marketingEmail Boolean   @default(false)
  marketingSms   Boolean   @default(false)
  lastLoginAt    DateTime?
  status         UserStatus @default(ACTIVE)

  // NextAuth 관계
  accounts       Account[]
  sessions       Session[]

  // 구독 관계
  subscription   Subscription?

  // 비즈니스 관계
  products       Product[]
  orders         Order[]

  // 재고 관리 관계
  warehouses     Warehouse[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  stockCounts    StockCount[]

  // 자사몰 관계
  reviews        Review[]
  wishlists      Wishlist[]
  addresses      Address[]
  cartItems      CartItem[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("users")
}

// 사용자 상태
enum UserStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
}

// 시스템 사용 모드
enum SystemMode {
  DROPSHIPPING  // 위탁판매 (무재고)
  INVENTORY     // 재고 관리
  HYBRID        // 통합 (위탁 + 재고)
}

// 사용자 역할
enum UserRole {
  ADMIN     // 관리자 (전체 권한)
  STAFF     // 직원 (제한된 관리 권한)
  CUSTOMER  // 일반 고객 (자사몰 전용)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// 구독 및 결제 관련
// ============================================

model Subscription {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 구독 플랜
  plan             SubscriptionPlan @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)

  // 토스페이먼츠 빌링키 (정기결제용)
  billingKey       String?
  customerKey      String?          @unique

  // 구독 기간
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // 취소 정보
  cancelAtPeriodEnd  Boolean       @default(false)
  canceledAt         DateTime?

  // 결제 내역
  payments           Payment[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("subscriptions")
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
}

model Payment {
  id               String        @id @default(cuid())
  subscriptionId   String
  subscription     Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // 토스페이먼츠 결제 정보
  paymentKey       String?       @unique
  orderId          String        @unique
  amount           Int

  // 결제 상태
  status           PaymentStatus @default(PENDING)

  // 결제 방법
  method           String?       // CARD, TRANSFER, etc.
  cardCompany      String?
  cardNumber       String?       // 마스킹된 카드번호

  // 실패 정보
  failReason       String?

  paidAt           DateTime?
  createdAt        DateTime      @default(now())

  @@index([subscriptionId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

// ============================================
// 도매처 관련
// ============================================

model Supplier {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  baseUrl     String

  // 인증 정보 (암호화 저장)
  credentials Json?

  isActive    Boolean   @default(true)

  // 관계
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("suppliers")
}

// ============================================
// 카테고리
// ============================================

model Category {
  id           String     @id @default(cuid())
  name         String
  coupangId    String?

  // 계층 구조
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")

  // 관계
  products     Product[]

  @@map("categories")
}

// ============================================
// 상품
// ============================================

model Product {
  id                   String    @id @default(cuid())

  // 관계 ID
  userId               String
  user                 User      @relation(fields: [userId], references: [id])

  supplierId           String
  supplier             Supplier  @relation(fields: [supplierId], references: [id])

  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id])

  // 도매처 정보
  supplierProductId    String
  supplierProductUrl   String?

  // 쿠팡 정보
  coupangProductId     String?
  coupangVendorItemId  String?
  coupangProductUrl    String?

  // 상품 정보
  name                 String
  description          String?   @db.Text

  // 이미지 (URL 배열)
  images               Json      @default("[]")

  // 옵션 (색상, 사이즈 등)
  options              Json      @default("[]")

  // 가격
  supplierPrice        Int
  sellingPrice         Int
  shippingFee          Int       @default(0)

  // 계산된 값
  margin               Float
  estimatedProfit      Int

  // 상태
  status               ProductStatus @default(DRAFT)

  // 메타데이터
  lastSyncedAt         DateTime?

  // 관계
  priceHistory         PriceHistory[]
  orders               Order[]
  stats                ProductStats[]

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([supplierId, supplierProductId])
  @@index([userId])
  @@index([status])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  PENDING
  REGISTERED
  ACTIVE
  PAUSED
  OUT_OF_STOCK
  DISCONTINUED
}

// ============================================
// 가격 히스토리
// ============================================

model PriceHistory {
  id              String   @id @default(cuid())

  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierPrice   Int
  sellingPrice    Int
  competitorPrice Int?

  recordedAt      DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("price_history")
}

// ============================================
// 주문
// ============================================

model Order {
  id               String      @id @default(cuid())

  // 관계
  productId        String
  product          Product     @relation(fields: [productId], references: [id])

  userId           String
  user             User        @relation(fields: [userId], references: [id])

  // 쿠팡 주문 정보
  coupangOrderId   String      @unique
  coupangOrderItemId String?

  // 주문 내용
  quantity         Int
  unitPrice        Int
  totalAmount      Int

  // 구매자 정보
  buyerName        String
  buyerPhone       String
  shippingAddress  String
  shippingMemo     String?

  // 상태
  status           OrderStatus @default(NEW)

  // 도매처 발주 정보
  supplierOrderId  String?
  supplierOrderedAt DateTime?

  // 배송 정보
  trackingCompany  String?
  trackingNumber   String?

  // 타임스탬프
  orderedAt        DateTime
  shippedAt        DateTime?
  deliveredAt      DateTime?

  // 관계
  history          OrderHistory[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, orderedAt])
  @@index([status])
  @@map("orders")
}

enum OrderStatus {
  NEW
  PENDING_ORDER
  ORDERED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

// ============================================
// 주문 히스토리
// ============================================

model OrderHistory {
  id        String      @id @default(cuid())

  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    OrderStatus
  note      String?

  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_history")
}

// ============================================
// 상품 통계
// ============================================

model ProductStats {
  id        String   @id @default(cuid())

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date

  views     Int      @default(0)
  clicks    Int      @default(0)
  sales     Int      @default(0)
  revenue   Int      @default(0)
  profit    Int      @default(0)

  @@unique([productId, date])
  @@index([date])
  @@map("product_stats")
}

// ============================================
// 시스템 설정
// ============================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ============================================
// 작업 로그
// ============================================

model JobLog {
  id        String   @id @default(cuid())

  jobType   String
  status    JobStatus

  startedAt DateTime
  endedAt   DateTime?

  result    Json?
  error     String?

  @@index([jobType, startedAt])
  @@map("job_logs")
}

enum JobStatus {
  RUNNING
  COMPLETED
  FAILED
}

// ============================================
// 리서치 - 키워드 분석
// ============================================

model Keyword {
  id              String   @id @default(cuid())

  keyword         String   @unique

  // 네이버 검색량 데이터
  naverSearchVolume    Int?      // 월간 검색량
  naverSearchTrend     Json?     // 최근 30일 트렌드 데이터

  // 쿠팡 데이터
  coupangProductCount  Int?      // 검색 결과 상품 수
  coupangAvgPrice      Int?      // 평균 가격
  coupangMinPrice      Int?      // 최저 가격
  coupangMaxPrice      Int?      // 최고 가격

  // 경쟁 강도 (계산된 지표)
  competitionScore     Float?    // 0~100 경쟁 강도
  opportunityScore     Float?    // 0~100 기회 점수

  // 관계
  snapshots       KeywordSnapshot[]
  trackedProducts TrackedProduct[]

  lastAnalyzedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([opportunityScore])
  @@map("keywords")
}

// 키워드 히스토리 (시계열 데이터)
model KeywordSnapshot {
  id              String   @id @default(cuid())

  keywordId       String
  keyword         Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  naverSearchVolume    Int?
  coupangProductCount  Int?
  coupangAvgPrice      Int?

  recordedAt      DateTime @default(now())

  @@index([keywordId, recordedAt])
  @@map("keyword_snapshots")
}

// ============================================
// 리서치 - 쿠팡 상품 추적
// ============================================

model TrackedProduct {
  id                  String   @id @default(cuid())

  // 쿠팡 상품 정보
  coupangProductId    String   @unique
  coupangUrl          String

  name                String
  brandName           String?
  sellerName          String?

  // 현재 상태
  currentPrice        Int
  originalPrice       Int?
  discountRate        Int?

  currentReviewCount  Int      @default(0)
  currentRating       Float?

  // 배송 정보
  isRocketDelivery    Boolean  @default(false)
  isFreeShipping      Boolean  @default(false)

  // 검색 순위 (키워드별)
  keywordId           String?
  keyword             Keyword? @relation(fields: [keywordId], references: [id])
  searchRank          Int?     // 해당 키워드 검색 시 순위

  // 관계
  priceSnapshots      ProductPriceSnapshot[]
  reviewSnapshots     ProductReviewSnapshot[]

  // 도매 매칭 정보
  matchedWholesaleUrl String?
  wholesalePrice      Int?
  estimatedMargin     Float?   // 예상 마진율

  isTracking          Boolean  @default(true)

  lastCrawledAt       DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([keywordId, searchRank])
  @@index([estimatedMargin])
  @@map("tracked_products")
}

// 상품 가격 스냅샷
model ProductPriceSnapshot {
  id              String   @id @default(cuid())

  productId       String
  product         TrackedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  price           Int
  originalPrice   Int?

  recordedAt      DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("product_price_snapshots")
}

// 리뷰 스냅샷 (리뷰 증가 속도 추적)
model ProductReviewSnapshot {
  id              String   @id @default(cuid())

  productId       String
  product         TrackedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  reviewCount     Int
  rating          Float?

  // 계산된 지표
  reviewGrowthRate Float?   // 일일 리뷰 증가율

  recordedAt      DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("product_review_snapshots")
}

// ============================================
// 리서치 - 마진 분석
// ============================================

model MarginAnalysis {
  id                  String   @id @default(cuid())

  // 검색 조건
  keyword             String

  // 쿠팡 상품 정보
  coupangProductId    String
  coupangProductName  String
  coupangPrice        Int
  coupangUrl          String

  // 도매 상품 정보
  wholesaleSource     String   // domeggook, etc.
  wholesaleProductId  String?
  wholesaleProductName String
  wholesalePrice      Int
  wholesaleUrl        String

  // 마진 계산
  priceDifference     Int      // 판매가 - 도매가
  marginRate          Float    // 마진율 (%)
  estimatedProfit     Int      // 예상 수익 (수수료 제외 후)

  // 유사도 점수
  similarityScore     Float?   // 상품 유사도 (0~1)

  analyzedAt          DateTime @default(now())

  @@index([keyword, marginRate])
  @@index([analyzedAt])
  @@map("margin_analyses")
}

// ============================================
// 리서치 - 네이버 검색 트렌드
// ============================================

model NaverTrend {
  id              String   @id @default(cuid())

  keyword         String

  // 기간
  startDate       DateTime
  endDate         DateTime

  // 트렌드 데이터 (일별)
  trendData       Json     // [{date: "2024-01-01", ratio: 85}, ...]

  // 요약 지표
  avgRatio        Float?   // 평균 비율
  maxRatio        Float?   // 최대 비율
  minRatio        Float?   // 최소 비율
  trendDirection  String?  // "rising", "falling", "stable"

  createdAt       DateTime @default(now())

  @@unique([keyword, startDate, endDate])
  @@index([keyword])
  @@map("naver_trends")
}

// ============================================
// 창고 관리 (재고 관리 모드)
// ============================================

model Warehouse {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  code        String   // 창고 코드 (예: WH001)
  address     String?
  description String?

  // 창고 유형
  type        WarehouseType @default(MAIN)

  // 상태
  isActive    Boolean  @default(true)

  // 관계
  locations   WarehouseLocation[]
  inventory   InventoryItem[]
  stockMovements StockMovement[]
  stockCounts StockCount[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, code])
  @@map("warehouses")
}

enum WarehouseType {
  MAIN        // 메인 창고
  SUB         // 보조 창고
  RETURN      // 반품 창고
  TEMP        // 임시 창고
}

// 창고 내 위치 (로케이션)
model WarehouseLocation {
  id          String    @id @default(cuid())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  // 위치 정보 (예: A-01-02 = A구역 1열 2단)
  zone        String    // 구역 (A, B, C...)
  aisle       String?   // 열 (01, 02...)
  shelf       String?   // 선반/단 (01, 02...)
  bin         String?   // 빈 (세부 위치)

  // 위치 코드 (자동 생성: zone-aisle-shelf-bin)
  code        String

  // 위치 특성
  capacity    Int?      // 수용 가능 수량
  isActive    Boolean   @default(true)

  // 관계
  inventory   InventoryItem[]

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

// ============================================
// 재고 관리
// ============================================

model InventoryItem {
  id              String   @id @default(cuid())

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 창고/위치
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])

  locationId      String?
  location        WarehouseLocation? @relation(fields: [locationId], references: [id])

  // 상품 정보
  sku             String   // 재고 관리 코드
  barcode         String?  // 바코드

  name            String
  description     String?
  category        String?
  brand           String?

  // 이미지
  imageUrl        String?

  // 가격 정보
  costPrice       Int      // 원가 (매입가)
  sellingPrice    Int      // 판매가 (현재 가격)
  comparePrice    Int?     // 정상가 (할인 전 가격, 세일 표시용)

  // 재고 수량
  quantity        Int      @default(0)  // 현재 재고
  reservedQty     Int      @default(0)  // 예약된 수량 (출고 대기)
  availableQty    Int      @default(0)  // 가용 재고 (quantity - reservedQty)

  // 안전재고 설정
  safetyStock     Int      @default(0)  // 안전재고 수량
  reorderPoint    Int      @default(0)  // 재주문점
  maxStock        Int?     // 최대 재고

  // 단위
  unit            String   @default("EA") // EA, BOX, SET 등

  // 상태
  status          InventoryStatus @default(ACTIVE)

  // 관계
  stockMovements  StockMovement[]
  countItems      StockCountItem[]

  // 자사몰 옵션 시스템
  optionGroups    ShopProductOptionGroup[]
  variants        ShopProductVariant[]

  // 자사몰 노출 설정
  isShopVisible   Boolean  @default(false)  // 자사몰에 노출 여부
  shopDescription String?  @db.Text         // 자사몰용 상세 설명
  shopImages      Json     @default("[]")   // 자사몰용 이미지 배열

  // 메타데이터
  lastCountedAt   DateTime?  // 마지막 실사일
  expiryDate      DateTime?  // 유통기한

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, sku])
  @@index([warehouseId])
  @@index([status])
  @@index([quantity])
  @@index([isShopVisible])
  @@map("inventory_items")
}

enum InventoryStatus {
  ACTIVE        // 활성
  INACTIVE      // 비활성
  DISCONTINUED  // 단종
  OUT_OF_STOCK  // 품절
}

// ============================================
// 재고 이동 (입출고)
// ============================================

model StockMovement {
  id              String   @id @default(cuid())

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 재고 아이템
  inventoryId     String
  inventory       InventoryItem @relation(fields: [inventoryId], references: [id])

  // 창고
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])

  // 이동 유형
  type            MovementType

  // 수량 (양수: 입고, 음수: 출고)
  quantity        Int
  beforeQty       Int      // 이동 전 수량
  afterQty        Int      // 이동 후 수량

  // 참조 정보
  referenceType   String?  // ORDER, PURCHASE, ADJUSTMENT, TRANSFER, COUNT
  referenceId     String?  // 관련 문서 ID

  // 비용
  unitCost        Int?     // 단위 원가 (입고 시)
  totalCost       Int?     // 총 비용

  // 메모
  note            String?
  reason          String?  // 사유 (조정, 폐기 등의 경우)

  // 처리자
  processedBy     String?  // 처리자 이름

  createdAt       DateTime @default(now())

  @@index([inventoryId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([type])
  @@map("stock_movements")
}

enum MovementType {
  // 입고
  PURCHASE      // 구매 입고
  RETURN_IN     // 반품 입고
  TRANSFER_IN   // 이동 입고 (타 창고에서)
  ADJUSTMENT_IN // 조정 입고 (재고 조정)

  // 출고
  SALE          // 판매 출고
  RETURN_OUT    // 반품 출고 (공급자에게)
  TRANSFER_OUT  // 이동 출고 (타 창고로)
  ADJUSTMENT_OUT // 조정 출고 (재고 조정)
  DISPOSE       // 폐기
}

// ============================================
// 재고 실사
// ============================================

model StockCount {
  id              String   @id @default(cuid())

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 창고
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])

  // 실사 정보
  countNumber     String   // 실사 번호 (예: SC-2024-001)
  countDate       DateTime // 실사 일자
  countType       StockCountType @default(FULL)

  // 상태
  status          StockCountStatus @default(DRAFT)

  // 요약
  totalItems      Int      @default(0)  // 총 품목 수
  matchedItems    Int      @default(0)  // 일치 품목 수
  discrepancyItems Int     @default(0)  // 차이 발생 품목 수

  // 메모
  note            String?

  // 실사 항목
  items           StockCountItem[]

  // 승인 정보
  approvedBy      String?
  approvedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, countNumber])
  @@index([warehouseId, countDate])
  @@map("stock_counts")
}

enum StockCountType {
  FULL      // 전체 실사
  PARTIAL   // 부분 실사
  CYCLE     // 순환 실사
  SPOT      // 임시 실사
}

enum StockCountStatus {
  DRAFT       // 작성 중
  IN_PROGRESS // 진행 중
  COMPLETED   // 완료
  APPROVED    // 승인됨
  CANCELLED   // 취소됨
}

// 실사 항목
model StockCountItem {
  id              String   @id @default(cuid())

  stockCountId    String
  stockCount      StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  inventoryId     String
  inventory       InventoryItem @relation(fields: [inventoryId], references: [id])

  // 수량
  systemQty       Int      // 시스템 재고
  countedQty      Int?     // 실사 수량
  difference      Int?     // 차이 (countedQty - systemQty)

  // 상태
  isCounted       Boolean  @default(false)
  isAdjusted      Boolean  @default(false) // 조정 완료 여부

  // 메모
  note            String?

  countedAt       DateTime?
  countedBy       String?

  @@unique([stockCountId, inventoryId])
  @@map("stock_count_items")
}

// ============================================
// 발주 (구매 주문)
// ============================================

model PurchaseOrder {
  id              String   @id @default(cuid())

  // 발주 번호
  orderNumber     String   @unique

  // 공급처
  supplierId      String?
  supplierName    String
  supplierContact String?

  // 상태
  status          PurchaseOrderStatus @default(DRAFT)

  // 날짜
  orderDate       DateTime
  expectedDate    DateTime? // 입고 예정일

  // 금액
  subtotal        Int       @default(0)
  tax             Int       @default(0)
  shippingCost    Int       @default(0)
  totalAmount     Int       @default(0)

  // 메모
  note            String?

  // 발주 항목
  items           PurchaseOrderItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

enum PurchaseOrderStatus {
  DRAFT           // 작성 중
  SUBMITTED       // 제출됨
  CONFIRMED       // 확인됨
  PARTIALLY_RECEIVED // 부분 입고
  RECEIVED        // 입고 완료
  CANCELLED       // 취소됨
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  // 상품 정보
  sku             String
  name            String
  unit            String   @default("EA")

  // 수량
  orderedQty      Int      // 발주 수량
  receivedQty     Int      @default(0) // 입고된 수량

  // 가격
  unitPrice       Int
  totalPrice      Int

  // 메모
  note            String?

  @@map("purchase_order_items")
}


// ============================================
// 자사몰 - 상품 옵션 시스템
// ============================================

// 상품 옵션 그룹 (예: 중량, 등급)
model ShopProductOptionGroup {
  id              String   @id @default(cuid())

  // 상품 (InventoryItem 참조)
  inventoryId     String
  inventory       InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  // 옵션 그룹 정보
  name            String   // 예: "중량", "등급", "포장"
  displayOrder    Int      @default(0) // 표시 순서
  isRequired      Boolean  @default(true) // 필수 선택 여부

  // 옵션 값들
  options         ShopProductOption[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([inventoryId])
  @@map("shop_product_option_groups")
}

// 상품 옵션 값 (예: 1kg, 3kg, 5kg)
model ShopProductOption {
  id              String   @id @default(cuid())

  // 옵션 그룹
  optionGroupId   String
  optionGroup     ShopProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  // 옵션 정보
  name            String   // 예: "1kg", "3kg", "프리미엄"
  additionalPrice Int      @default(0) // 추가 금액 (+0, +15000, etc.)
  displayOrder    Int      @default(0) // 표시 순서

  // 상태
  isActive        Boolean  @default(true)

  // 변형(Variant)과의 관계
  variants        ShopProductVariantOption[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("shop_product_options")
}

// 상품 변형 (옵션 조합별 재고/가격)
// 예: 사과 1kg 일반, 사과 1kg 프리미엄, 사과 3kg 일반, 사과 3kg 프리미엄
model ShopProductVariant {
  id              String   @id @default(cuid())

  // 상품 (InventoryItem 참조)
  inventoryId     String
  inventory       InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  // 변형 정보
  sku             String?  // 변형별 SKU (선택사항)
  name            String?  // 변형명 (자동 생성 가능: "1kg / 일반")

  // 가격 (기본가 + 옵션 추가금액 = 최종가격)
  price           Int      // 이 변형의 판매가격
  comparePrice    Int?     // 비교가격 (할인 전 가격)

  // 재고
  stock           Int      @default(0)
  lowStockAlert   Int      @default(5) // 재고 부족 알림 기준

  // 상태
  isActive        Boolean  @default(true)

  // 이 변형에 포함된 옵션들
  options         ShopProductVariantOption[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([inventoryId])
  @@index([isActive])
  @@map("shop_product_variants")
}

// 변형-옵션 연결 테이블 (다대다)
model ShopProductVariantOption {
  id              String   @id @default(cuid())

  variantId       String
  variant         ShopProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  optionId        String
  option          ShopProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionId])
  @@map("shop_product_variant_options")
}

// ============================================
// 자사몰 - 카테고리 관리
// ============================================

model ShopCategory {
  id              String   @id @default(cuid())

  // 카테고리 정보
  name            String   // 카테고리명
  slug            String   @unique // URL용 슬러그
  code            String   @unique // 카테고리 코드 (상품코드 생성용, 예: FRUIT, VEG)
  description     String?  // 설명
  imageUrl        String?  // 카테고리 이미지

  // 계층 구조
  parentId        String?
  parent          ShopCategory?  @relation("ShopCategoryHierarchy", fields: [parentId], references: [id])
  children        ShopCategory[] @relation("ShopCategoryHierarchy")

  // 표시 설정
  displayOrder    Int      @default(0) // 표시 순서
  isActive        Boolean  @default(true) // 활성화 여부
  isVisible       Boolean  @default(true) // 쇼핑몰 노출 여부

  // 아이콘 (lucide-react 아이콘명)
  icon            String?

  // 상품코드 시퀀스 (카테고리별 자동 증가)
  productSeq      Int      @default(0) // 마지막으로 생성된 상품 번호

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([parentId])
  @@index([displayOrder])
  @@map("shop_categories")
}

// ============================================
// 자사몰 - 상품 리뷰
// ============================================

model Review {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(255)

  userId       String   @db.VarChar(255)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId    String   @db.VarChar(255) // inventory_items.id
  orderId      String?  @db.VarChar(255) // 주문번호 (구매 인증용)

  // 리뷰 내용
  rating       Int      // 1-5 별점
  content      String?  @db.Text
  images       Json     @default("[]") // 리뷰 이미지 URL 배열

  // 상태
  isVerified   Boolean  @default(false) // 구매 인증 여부
  isVisible    Boolean  @default(true)  // 노출 여부

  // 통계
  helpfulCount Int      @default(0) // 도움이 됐어요 수

  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @db.Timestamp(6)

  @@index([productId])
  @@index([userId])
  @@unique([userId, orderId, productId]) // 동일 주문의 동일 상품에 대해 1개의 리뷰만 허용
  @@map("reviews")
}

// ============================================
// 자사몰 찜하기 (위시리스트)
// ============================================

model Wishlist {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(255)
  userId    String   @db.VarChar(255)
  productId String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlists")
}

// ============================================
// 자사몰 배송지
// ============================================

model Address {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(255)
  userId        String   @db.VarChar(255)
  name          String   @db.VarChar(255)
  recipientName String   @db.VarChar(255)
  phone         String   @db.VarChar(50)
  zipCode       String   @db.VarChar(20)
  address       String   @db.VarChar(500)
  addressDetail String?  @db.VarChar(255)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @db.Timestamp(6)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ============================================
// 자사몰 장바구니
// ============================================

model CartItem {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(255)
  userId        String   @db.VarChar(255)
  productId     String   @db.VarChar(255)
  variantId     String   @default("") @db.VarChar(255)
  productName   String   @db.VarChar(255)
  productImage  String?  @db.VarChar(255)
  price         Int
  originalPrice Int?
  unit          String?  @db.VarChar(100)
  quantity      Int      @default(1)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @db.Timestamp(6)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@map("cart_items")
}
